  "exclude": [
    "node_modules",
    "dist",
    "build",
    "server/test-integration.ts",
    "server/autonomous-monitor.ts",
    "server/coding-agent.ts",
    "server/jarvis-*.ts",
    "server/llm-orchestrator.ts",
    "server/routers.*.ts"
  ]
