# Auren local-first para Windows
# O padrão abaixo usa Ollama local e não exige cartão, conta ou API paga.
# Nunca publique o arquivo .env nem cole chaves no frontend.

# Servidor local
PORT=3000
NODE_ENV=development
VITE_LOCAL_MODE=true
JARVIS_LOCAL_MODE=true

# Somente se VITE_LOCAL_MODE=false; nunca coloque uma senha real no Git.
# VITE_AUTHORIZED_EMAILS=seu-email@exemplo.com
# VITE_AUTH_GATE_PASSWORD=defina-no-seu-.env

# Identidade local criada somente para requisições de loopback
JARVIS_LOCAL_OPEN_ID=jarvis-local-user
JARVIS_LOCAL_USER_NAME=Meu Auren
JARVIS_LOCAL_USER_EMAIL=

# Provedor gratuito local: Ollama em http://127.0.0.1:11434/v1
# O servidor Ollama aceita a chave fictícia "ollama" e não cobra por chamada.
AUREN_LLM_PROVIDER=local
AUREN_LOCAL_LLM=true
AUREN_LOCAL_LLM_BASE=http://127.0.0.1:11434/v1
AUREN_LOCAL_LLM_KEY=ollama
# 1.5B é o modo rápido para CPU; troque por qwen2.5:3b se preferir mais qualidade.
AUREN_LOCAL_LLM_MODEL=qwen2.5:1.5b
AUREN_LOCAL_LLM_NATIVE=true
AUREN_LOCAL_LLM_KEEP_ALIVE=10m
AUREN_LOCAL_LLM_NUM_CTX=2048
AUREN_LOCAL_LLM_NUM_PREDICT=180
AUREN_LOCAL_LLM_THINK=false

# Ponte Windows opcional; mantenha o token somente no .env local
AUREN_DESKTOP_BRIDGE_URL=http://127.0.0.1:8765
AUREN_DESKTOP_BRIDGE_TOKEN=

# Dados importantes ficam neste diretório e são gravados de forma atômica.
# No Windows, você pode usar um caminho absoluto, por exemplo:
# JARVIS_DATA_DIR=C:\Users\SEU_USUARIO\AppData\Local\Auren\data
JARVIS_DATA_DIR=./data
JARVIS_MAX_LOCAL_MESSAGES=80
JARVIS_MAX_LOCAL_CONVERSATIONS=20
JARVIS_MAX_LOCAL_MEMORY=200

# Alternativas opcionais, somente se você decidir usar um provedor remoto.
# AUREN_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini

# Alternativa Manus/Forge, se você possuir essas variáveis no ambiente local.
# AUREN_LLM_PROVIDER=forge
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
# BUILT_IN_FORGE_API_KEY=

# Banco opcional. Se ficar vazio, conversas, memórias e usuário usam o JSON local.
# DATABASE_URL=
