# ============================================
# JARVIS Ultra-Premium - Configuração de Ambiente
# ============================================

# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/jarvis_db

# LLM provider (optional; supports OpenAI-compatible free tiers or self-hosted endpoints)
# Set LLM_API_KEY and LLM_BASE_URL for a generic provider.
# Alternatively use OPENAI_API_KEY and optionally OPENAI_BASE_URL.
# Never commit real keys to GitHub.
LLM_API_KEY=
LLM_BASE_URL=
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration
PORT=3000
NODE_ENV=production

# OAuth Configuration (Manus)
OAUTH_SERVER_URL=https://oauth.manus.im
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

# Security & Privacy
# Authentication is handled by the official OAuth session.
# Never put a user password, Pix key, bank token or provider secret here.

# Deployment
VERCEL_URL=https://jarvis-ultra.vercel.app
RAILWAY_URL=https://jarvis-backend.railway.app

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# Feature Flags
ENABLE_DEEP_THINKING=true
# Keep autonomous external actions disabled until manually reviewed.
ENABLE_AUTONOMOUS_AGENCY=false
ENABLE_GUARDIAN_PROTOCOL=true
ENABLE_REAL_TIME_SEARCH=true
