{
  "name": "jarvis-command-center",
  "version": "1.0.0",
  "description": "JARVIS Ultra-Premium - IA Privada de Elite",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && tsc --noEmit",
    "start": "NODE_ENV=production node dist/server/_core/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "db:push": "drizzle-kit push:mysql",
    "db:migrate": "drizzle-kit migrate:mysql",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@trpc/client": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.263.1",
    "drizzle-orm": "^0.28.0",
    "mysql2": "^3.6.0",
    "zod": "^3.22.4",
    "axios": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "@types/react": "^18.2.0",
    "typescript": "^5.1.3",
    "vite": "^4.4.0",
    "vitest": "^0.34.0",
    "tsx": "^3.12.7",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
